{
  // 共有サーバー（Cloudflare Worker）。Cloudflare の「Workers Builds」（GitHub 連携）が、
  // リポジトリのルートでこの設定を読んでビルド・デプロイする。ログイン情報はここに書かない
  "name": "tournament",
  "main": "worker/src/index.js",
  "compatibility_date": "2026-09-01",
  "workers_dev": true,
  // 画面（web/app.js）は生成物でコミットしないため、デプロイ前に作る。依存が未インストールのときだけ npm ci する
  "build": {
    "command": "test -d node_modules || npm ci --ignore-scripts && npm run build"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tournament",
      "database_id": "6ad57a79-0d80-436e-9e69-092dc7a2d761"
    }
  ],
  // PR ブランチのプレビュー（wrangler preview）は、本番とは別のデータベースを使う
  "previews": {
    "d1_databases": [
      {
        "binding": "DB",
        "database_id": "51047be4-8c28-4831-a636-7f77abb662f2"
      }
    ]
  },
  // 毎日 03:17（UTC）に、期限切れの共有を消す（worker の scheduled）。Cron は1つだけ使う
  "triggers": {
    "crons": ["17 3 * * *"]
  },
  "assets": {
    "directory": "web",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  }
}
