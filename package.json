{
  "name": "bukatsu-taikai",
  "productName": "部内大会トーナメント",
  "version": "1.0.0",
  "description": "部内大会のトーナメント表・総当たり表作成アプリ",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test \"test/unit/*.test.js\"",
    "test:e2e": "npm run build && playwright test",
    "start": "npm run build && electron .",
    "dist:win": "npm run build && electron-builder --win portable --x64",
    "icons": "node scripts/make-icons.mjs",
    "serve": "npm run build && node scripts/serve.mjs",
    "serve:share": "npm run build && WITH_SHARE_API=1 PORT=4174 node scripts/serve.mjs",
    "test:electron": "npm run build && node test/electron/smoke.mjs"
  },
  "build": {
    "appId": "jp.local.bukatsu-taikai",
    "productName": "部内大会トーナメント",
    "artifactName": "bukatsu-taikai-${version}-portable.exe",
    "files": [
      "electron/**",
      "web/**",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "portable",
      "executableName": "bukatsu-taikai",
      "icon": "build/icon.ico"
    }
  },
  "devDependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans-jp": "^5.3.1",
    "@playwright/test": "^1.56.1",
    "electron": "^45.2.1",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2"
  },
  "author": "部内大会運営"
}
